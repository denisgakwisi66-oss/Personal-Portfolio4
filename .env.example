# Copy this file to .env for local `netlify dev` testing, and set the same
# values under Site configuration > Environment variables in the Netlify
# dashboard for production. Never commit a real .env file.

# Required — free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — overrides the default chat model (gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
